NEXT_PUBLIC_SITE_URL=http://localhost:3001

# LLM (script generation, scene splitting, transcript cleanup)
# Groq: use a chat model (not gpt-oss) — reasoning models often return empty content.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Image generation — Gemini 2.5 Flash Image when the key has image quota.
# Free-tier keys often report "quota limit 0"; Image/Motion then use Pollinations.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extras — tried in order when the primary key has no image quota
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Or comma-separated: GEMINI_API_KEYS=key1,key2
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Minutes to skip Gemini after a failure before retrying (default 10 min)
GEMINI_COOLDOWN_MS=600000

# Pollinations — free, no key needed. Used automatically when Gemini is unavailable.
IMAGE_GEN_API_KEY=
# Milliseconds to wait per scene for AI stills (public Pollinations, sequential)
IMAGE_FETCH_TIMEOUT_MS=8000

# AI Horde — free community image GPUs (no paid key). Anonymous key works;
# register at https://aihorde.net for better queue priority.
# AI_HORDE_API_KEY=0000000000
# AI_HORDE_MODEL=SDXL 1.0
# AI_HORDE_TIMEOUT_MS=16000
# AI_HORDE_DISABLED=true

# Cloudflare Workers AI — FLUX.1 Schnell (free daily neurons on free plan).
# Dashboard → Workers AI → Use REST API → create token + copy Account ID.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4

# Puter.js — User-Pays image API (Node). Create a token at https://puter.com
# Defaults to Cloudflare provider + FLUX Schnell through Puter.
# PUTER_AUTH_TOKEN=
# PUTER_IMAGE_PROVIDER=cloudflare
# PUTER_IMAGE_MODEL=black-forest-labs/flux-schnell

# Fal.ai, Replicate, Hugging Face, JSON2Video — used in that order, then Remotion.
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/hunyuan-video
FAL_VIDEO_RESOLUTION=480p
FAL_VIDEO_NUM_FRAMES=85
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=lucataco/ltx-video
# Hugging Face uses Together via the Inference Providers router (FLUX.1-schnell).
HF_IMAGE_PROVIDER=together
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B
# Hugging Face Inference (FLUX). Also accepts HF_TOKEN.
HUGGINGFACE_API_KEY=
JSON2VIDEO_API_KEY=

# ComfyUI — optional local text-to-video if Fal is not configured.
COMFYUI_BASE_URL=
COMFYUI_T2V_WORKFLOW=workflows/comfyui-t2v.api.json
COMFYUI_I2V_WORKFLOW=workflows/comfyui-i2v.api.json
COMFYUI_TIMEOUT_MS=300000
COMFYUI_POLL_MS=2000
COMFYUI_ETA_SECONDS=180

# TTS — Windows SAPI locally; on Vercel/Linux use edge then Google Translate TTS
TTS_PROVIDER=sapi

# Vercel durable demo store (required for Production). Prefer Vercel Blob —
# connect Storage → Blob in the project dashboard; token is injected as:
# BLOB_READ_WRITE_TOKEN=
# Optional alternative:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Force in-request job completion even on a long-lived Node host:
# SYNC_JOBS=true

# YouTube transcript extraction
YOUTUBE_TRANSCRIPT_PROVIDER=youtube-caption-extractor
