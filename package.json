{
  "name": "reelforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-dev-server.ps1",
    "build": "next build && node scripts/copy-css.mjs",
    "postbuild": "node scripts/copy-css.mjs",
    "start": "next start -p 3001",
    "lint": "next lint",
    "check:providers": "tsx --env-file=.env.local scripts/check-providers.mts",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@heyputer/puter.js": "^2.6.3",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@remotion/bundler": "^4.0.509",
    "@remotion/renderer": "^4.0.509",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.66.0",
    "@travisvn/edge-tts": "^1.0.2",
    "@types/node": "20.14.13",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.509",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.7.2",
    "youtube-caption-extractor": "^1.0.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.1": true
  }
}
